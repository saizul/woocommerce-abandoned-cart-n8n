{
  "name": "WooCommerce - Abandoned checkout recovery",
  "nodes": [
    {
      "parameters": {
        "content": "## Abandoned checkout recovery\n1. Import, then replace every REPLACE_WITH_* placeholder (Config node, credentials, spreadsheet id).\n2. In WooCommerce > Settings > Advanced > Webhooks add two webhooks (Order created, Order updated) pointing to this workflow's **Production URL**.\n3. Create the Google Sheet tab \"Recovery Log\" with the header row used by the log nodes.\n4. Activate the workflow.",
        "width": 420,
        "height": 230
      },
      "id": "e2640a8e-53f4-417a-a055-131c2478e89b",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -120
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "woo-checkout-recovery",
        "responseMode": "onReceived",
        "options": {}
