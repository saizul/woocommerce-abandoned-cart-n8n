    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Keep only unpaid (pending / failed) online-payment orders that we can contact.\nconst order = $input.first().json.body ?? $input.first().json;\nconst cfg = $('Config').first().json;\nfunction normalizePhone(raw, cc) {\n  let d = String(raw || '').replace(/\\D/g, '');\n  if (d.startsWith('00')) d = d.slice(2);\n  if (!d) return '';\n  if (d.startsWith(cc)) return d;\n  if (d.startsWith('0')) return cc + d.slice(1);\n  return cc + d;\n}\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n\nif (!order || !order.id) return [];\nif (!['pending', 'failed'].includes(order.status)) return [];\nif (order.payment_method === 'cod') return [];\n\n// WooCommerce sends several webhooks per order. Process each order only once.\nconst seen = $getWorkflowStaticData('global');\nseen.orders = seen.orders || {};\nconst now = Date.now();\nfor (const id of Object.keys(seen.orders)) {\n  if (now - seen.orders[id] > 7 * 24 * 3600 * 1000) delete seen.orders[id];\n}\nif (seen.orders[order.id]) return [];\n\nconst b = order.billing || {};\nconst phone = normalizePhone(b.phone, cfg.defaultCountryCode);\nconst email = b.email || '';\nif (!phone && !email) return [];\nseen.orders[order.id] = now;\n\nconst name = b.first_name || 'there';\nconst total = order.currency_symbol ? order.currency_symbol + order.total : order.total + ' ' + order.currency;\nconst checkoutUrl = order.payment_url ||\n  (cfg.siteUrl + '/checkout/order-pay/' + order.id + '/?pay_for_order=true&key=' + order.order_key);\n\nconst wa = (template) => ({\n  messaging_product: 'whatsapp',\n  to: phone,\n  type: 'template',\n  template: {\n    name: template,\n    language: { code: cfg.waLanguage },\n    components: [{\n      type: 'body',\n      parameters: [\n        { type: 'text', text: name },\n        { type: 'text', text: String(total) },\n        { type: 'text', text: checkoutUrl },\n      ],\n    }],\n  },\n});\n\nconst html = (intro) =>\n  '<p>Hi ' + esc(name) + ',</p><p>' + intro + '</p>' +\n  '<p><a href=\"' + esc(checkoutUrl) + '\">Complete your order (' + esc(total) + ')</a></p>' +\n  '<p>Need help? Just reply to this email.</p>';\n\nreturn [{\n  json: {\n    orderId: order.id,\n    status: order.status,\n    name,\n    phone,\n    email,\n    total,\n    currency: order.currency,\n    checkoutUrl,\n    waReminder1: wa(cfg.waTemplateReminder1),\n    waReminder2: wa(cfg.waTemplateReminder2),\n    emailSubject1: 'You left something behind - order #' + order.id,\n    emailHtml1: html('Your order is saved and waiting for payment. It only takes a minute to finish.'),\n    emailSubject2: 'Last reminder: your order #' + order.id + ' is still unpaid',\n    emailHtml2: html('This is a last reminder. Unpaid orders are cancelled automatically, so please complete payment soon if you still want these items.'),\n  },\n}];"
      },
