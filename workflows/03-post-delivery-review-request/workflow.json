    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Prepare the review request for an order that just became \"completed\".\nconst order = $input.first().json;\nconst cfg = $('Config').first().json;\nfunction normalizePhone(raw, cc) {\n  let d = String(raw || '').replace(/\\D/g, '');\n  if (d.startsWith('00')) d = d.slice(2);\n  if (!d) return '';\n  if (d.startsWith(cc)) return d;\n  if (d.startsWith('0')) return cc + d.slice(1);\n  return cc + d;\n}\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n\nconst meta = order.meta_data || [];\nif (meta.some((m) => m.key === '_review_request_scheduled' || m.key === '_review_requested')) return []; // already handled\n\nconst b = order.billing || {};\nconst phone = normalizePhone(b.phone, cfg.defaultCountryCode);\nconst email = b.email || '';\nif (!phone && !email) return [];\n\nconst name = b.first_name || 'there';\nconst first = (order.line_items || [])[0] || {};\nconst reviewUrl = cfg.reviewUrl || (cfg.siteUrl + '/?p=' + first.product_id + '#reviews');\n\nreturn [{\n  json: {\n    orderId: order.id,\n    name,\n    phone,\n    email,\n    reviewUrl,\n    waReview: {\n      messaging_product: 'whatsapp',\n      to: phone,\n      type: 'template',\n      template: {\n        name: cfg.waTemplateReview,\n        language: { code: cfg.waLanguage },\n        components: [{ type: 'body', parameters: [\n          { type: 'text', text: name },\n          { type: 'text', text: first.name || 'your order' },\n          { type: 'text', text: reviewUrl },\n        ] }],\n      },\n    },\n    emailSubject: 'How was your order #' + order.id + '?',\n    emailHtml: '<p>Hi ' + esc(name) + ',</p><p>We hope you are enjoying ' + esc(first.name || 'your order') + '. ' +\n      'Could you take a minute to share a review? It helps other shoppers a lot.</p>' +\n      '<p><a href=\"' + esc(reviewUrl) + '\">Write a review</a></p><p>Thank you!</p>',\n  },\n}];"
      },
      "id": "1ff38ef9-8632-4874-a86b-41d63fcd6476",
      "name": "Normalize order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $('Config').first().json.siteUrl }}/wp-json/wc/v3/orders/{{ $('Normalize order').first().json.orderId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ meta_data: [{ key: \"_review_request_scheduled\", value: new Date().toISOString() }] }) }}"
      },
      "id": "588a783f-abcf-4c58-a8f4-42f777bdb7cc",
