    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normalize a new COD order and build the WhatsApp template payload.\nconst order = $input.first().json.body ?? $input.first().json;\nconst cfg = $('Config').first().json;\nfunction normalizePhone(raw, cc) {\n  let d = String(raw || '').replace(/\\D/g, '');\n  if (d.startsWith('00')) d = d.slice(2);\n  if (!d) return '';\n  if (d.startsWith(cc)) return d;\n  if (d.startsWith('0')) return cc + d.slice(1);\n  return cc + d;\n}\n\nif (!order || !order.id) return [];\nconst b = order.billing || {};\nconst s = order.shipping || {};\nconst phone = normalizePhone(b.phone, cfg.defaultCountryCode);\nconst items = (order.line_items || []).map((i) => i.quantity + ' x ' + i.name).join(', ');\nconst address = [s.address_1 || b.address_1, s.city || b.city, s.state || b.state].filter(Boolean).join(', ');\nconst total = order.currency_symbol ? order.currency_symbol + order.total : order.total + ' ' + order.currency;\nconst name = b.first_name || 'Customer';\n\nreturn [{\n  json: {\n    orderId: order.id,\n    name: ((b.first_name || '') + ' ' + (b.last_name || '')).trim(),\n    phone,\n    address,\n    items,\n    total,\n    createdAt: order.date_created,\n    waConfirm: phone ? {\n      messaging_product: 'whatsapp',\n      to: phone,\n      type: 'template',\n      template: {\n        name: cfg.waTemplateConfirm,\n        language: { code: cfg.waLanguage },\n        components: [\n          { type: 'body', parameters: [\n            { type: 'text', text: name },\n            { type: 'text', text: String(order.id) },\n            { type: 'text', text: String(total) },\n          ] },\n          { type: 'button', sub_type: 'quick_reply', index: '0', parameters: [{ type: 'payload', payload: 'CONFIRM|' + order.id }] },\n          { type: 'button', sub_type: 'quick_reply', index: '1', parameters: [{ type: 'payload', payload: 'CANCEL|' + order.id }] },\n        ],\n      },\n    } : null,\n  },\n}];"
      },
      "id": "23e25591-2281-40b8-acc7-a79e46394a65",
      "name": "Normalize COD order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ]
    },
