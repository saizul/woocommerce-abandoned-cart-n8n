    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Extract the customer's button tap from the Meta webhook payload.\nconst body = $input.first().json.body ?? {};\nconst msg = body.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\nif (!msg) return []; // status callbacks (sent / delivered / read) are ignored\n\nconst payload = msg.button?.payload || msg.interactive?.button_reply?.id || '';\nconst m = /^(CONFIRM|CANCEL)\\|(\\d+)$/.exec(payload);\nif (!m) return [];\n\nreturn [{ json: { action: m[1], orderId: Number(m[2]), from: msg.from, repliedAt: new Date().toISOString() } }];"
      },
      "id": "0935b426-01e4-4cef-ac34-df8ef2dc58c9",
      "name": "Parse reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
